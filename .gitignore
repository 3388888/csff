# Keeps build output, caches, demo files and generated 3D exports out of the repo.
# Rust / Cargo — workspace build output (gigabytes; regenerated by `cargo build`)
/target/
**/target/

# Node (legacy Electron app)
node_modules/
dist/

# Local caches the app writes next to demos / in the app folder
demo-cache/
.demo-reader/
3d ports/
maps3d/

# Test data pulled from demos.tf — large, re-downloadable
testdemos/

# Demos and archives should never be committed
*.dem
*.dem.bz2
*.vdm

# Generated 3D exports
*.glb

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
*.swp
