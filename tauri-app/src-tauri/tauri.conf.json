{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CSGO Demo Highlights",
  "version": "0.1.0",
  "identifier": "cc.demo.highlights",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CSGO Demo Highlights",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
